{
  // ==========================================
  // 1. 基础编辑器设置 (Editor)
  // ==========================================
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontSize": 15,
  "editor.tabSize": 4,
  "editor.wordWrap": "on",
  "editor.lineNumbers": "relative",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorSurroundingLines": 10,
  "editor.lightbulb.enabled": "off",
  "editor.autoClosingBrackets": "always",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.suggest.insertMode": "replace",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.quickSuggestionsDelay": 100,
  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": false
  },
  "editor.inlineSuggest.enabled": false,
  "editor.inlineSuggest.minShowDelay": 10000,
  "editor.inlineSuggest.edits.allowCodeShifting": "never",
  "editor.inlineSuggest.edits.renderSideBySide": "never",
  "editor.inlineSuggest.showToolbar": "never",
  "editor.inlineSuggest.syntaxHighlightingEnabled": false,
  "editor.inlineSuggest.edits.showLongDistanceHint": false,
  "editor.screenReaderAnnounceInlineSuggestion": false,
  
  // ==========================================
  // 2. 界面与外观 (Workbench & Appearance)
  // ==========================================
  "workbench.colorTheme": "Bogem's Night Owl",
  "workbench.iconTheme": "vscode-icons",
  "workbench.startupEditor": "none",
  "workbench.editor.showTabs": "single",
  "workbench.editor.enablePreview": true,
  "workbench.editor.reuseTabs": true,
  "workbench.editor.useModal": "off",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.empty.hint": "hidden",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.activityBar.compact": true,
  "workbench.commandPalette.showAskInChat": false,
  "window.menuBarVisibility": "hidden",
  "window.customMenuBarAltFocus": false,
  "window.enableMenuBarMnemonics": false,
  "window.openFoldersInNewWindow": "on",
  "zenMode.showTabs": "single",
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": false,

  // ==========================================
  // 3. 终端设置 (Terminal)
  // ==========================================
  "terminal.integrated.fontFamily": "JetBrainsMonoNL Nerd Font",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
  "terminal.integrated.suggest.quickSuggestions": {
    "commands": "on",
    "arguments": "on",
    "unknown": "on"
  },
  "terminal.integrated.commandsToSkipShell": ["matlab.interrupt"],

  // ==========================================
  // 4. 特定语言与格式化器 (Languages & Formatters)
  // ==========================================
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.quickSuggestions": { "strings": false }
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop"
  },
  "[matlab]": {
    "editor.defaultFormatter": "AffenWiesel.matlab-formatter"
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  
  // 语言细节配置
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.latex.format.enabled": true,
  "latex-workshop.latex.formatter": "latexindent",
  "C_Cpp.suggestSnippets": false,
  "C_Cpp.intelliSenseEngine": "disabled",
  "files.associations": { "*.h": "c" },
  "json.schemaDownload.enable": false,
  "python.analysis.completeFunctionParens": true,
  "python.analysis.exclude": [
    "data", "output", "**/*.log", "**/node_modules", "**/__pycache__", "**/.*"
  ],
  "python.analysis.inlayHints.pytestParameters": true,
  "python.createEnvironment.trigger": "off",
  "notebook.lineNumbers": "on",
  "notebook.output.textLineLimit": 40,
  "vscode-office.editorTheme": "Github Dark",
  "markdown-preview-enhanced.previewTheme": "atom-dark.css",

  // ==========================================
  // 5. Git 与 扩展管理 (Git & Extensions)
  // ==========================================
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "never",
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": true,
  "extensions.ignoreRecommendations": true,
  "vsicons.dontShowNewVersionMessage": true,
  "update.enableWindowsBackgroundUpdates": true,
  "update.mode": "none",
  "security.allowedUNCHosts": ["wsl.localhost"],

  // ==========================================
  // 6. Vim 插件配置 (VSCodeVim)
  // ==========================================
  "vim.timeout": 400,
  "vim.leader": " ",
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.statusBarColorControl": false,
  "vim.cursorStylePerMode.normal": "block",
  "vim.cursorStylePerMode.insert": "line",
  "vim.cursorStylePerMode.replace": "underline",
  "vim.autoSwitchInputMethod.enable": false,
  "vim.autoSwitchInputMethod.defaultIM": "com.microsoft.inputmethod.tips",
  "extensions.experimental.affinity": { "vscodevim.vim": 1 },
  "vim.handleKeys": {
    "<C-c>": false, "<C-v>": true, "<C-x>": false,
    "<C-j>": false, "<C-f>": false, "<C-p>": false,
    "<C-u>": false, "<C-b>": false, "<C-e>": false,
    "<C-a>": true, "<C-w>": true, "<C-d>": false,
    "<C-s>": false, "<C-z>": false
  },
  // Easymotion
  "vim.easymotion": true,
  "vim.easymotionKeys": "jkluiophnmvc,asdfgwer",
  "vim.easymotionMarkerBackgroundColor": "#3a3f5a",
  "vim.easymotionMarkerForegroundColorOneChar": "#ffd700",
  "vim.easymotionMarkerForegroundColorTwoCharFirst": "#ffd700",
  "vim.easymotionMarkerForegroundColorTwoCharSecond": "#ffffff",
  // Vim 快捷键映射
  "vim.operatorPendingModeKeyBindings": [
    { "before": ["L"], "after": ["$"] },
    { "before": ["H"], "after": ["^"] }
  ],
  "vim.insertModeKeyBindings": [
    { "before": ["j", "k"], "after": ["<Esc>", "l"] }
  ],
  "vim.visualModeKeyBindings": [
    { "before": ["<leader>", "i"], "after": ["<leader>", "<leader>", "b"] },
    { "before": ["<leader>", ","], "after": ["<leader>", "<leader>", "e"] }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["p"], "after": ["p", "g", "v", "y"] },
    { "before": ["."], "after": [";"] },
    { "before": [";"], "after": [":"] },
    { "before": ["<leader>", "k"], "after": ["1", "5", "k"] },
    { "before": ["<leader>", "j"], "after": ["1", "5", "j"] },
    { "before": ["<backspace>"], "commands": ["editor.action.outdentLines"] },
    { "before": ["<tab>"], "commands": ["editor.action.indentLines"] },
    { "before": ["J"], "after": ["5", "j"] },
    { "before": ["K"], "after": ["5", "k"] },
    { "before": ["H"], "after": ["^"] },
    { "before": ["L"], "after": ["$"] }
  ],
  "vim.normalModeKeyBindings": [],
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["<CR>"], "after": ["i", " ", "<Esc>", "i"] },
    { "before": ["H"], "after": ["^"] },
    { "before": ["."], "after": [";"] },
    { "before": [";"], "after": [":"] },
    { "before": ["<leader>", "t"], "commands": ["extension.terminalCapture.runCapture"] },
    { "before": ["<leader>", "p"], "commands": ["workbench.action.showCommands"], "silent": true },
    { "before": ["L"], "after": ["$"] },
    { "before": ["<leader>", "9"], "after": ["c", "i", "W", "(", ")", "<Esc>", "P"] },
    { "before": ["<leader>", "{"], "after": ["c", "i", "W", "{", "}", "<Esc>", "P"] },
    { "before": ["\""], "after": ["c", "i", "W", "\"", "\"", "<Esc>", "P"] },
    { "before": ["<leader>", "'"], "after": ["c", "i", "W", "'", "'", "<Esc>", "P"] },
    { "before": ["<leader>", "["], "after": ["c", "i", "W", "[", "]", "<Esc>", "P"] },
    { "before": ["<leader>", "k"], "after": ["1", "5", "k"] },
    { "before": ["<leader>", "j"], "after": ["1", "5", "j"] },
    { "before": ["<leader>", "h"], "commands": ["workbench.action.focusLeftGroup"] },
    { "before": ["<leader>", "l"], "commands": ["workbench.action.focusRightGroup"] },
    { "before": ["<leader>", "z"], "commands": ["undo"] },
    { "before": ["="], "commands": ["editor.action.fontZoomIn"] },
    { "before": ["-"], "commands": ["editor.action.fontZoomOut"] },
    { "before": ["<leader>", "v"], "commands": ["workbench.action.splitEditor", "workbench.action.closeSidebar"] },
    { "before": ["<leader>", "o"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<leader>", "e"], "commands": ["workbench.view.explorer", "workbench.files.action.focusFilesExplorer"] },
    { "before": ["<leader>", "b"], "commands": ["editor.action.jumpToBracket"] },
    { "before": ["<leader>", "r"], "commands": ["editor.action.rename"] },
    { "before": ["<leader>", "y"], "after": ["m", "a", "y", "y", "p", "`", "a"] },
    { "before": ["<leader>", "f"], "after": ["<leader>", "<leader>", "s"] },
    { "before": ["<backspace>"], "commands": ["editor.action.outdentLines"] },
    { "before": ["<tab>"], "after": [">", ">"] },
    { "before": ["<leader>", "i"], "after": ["<leader>", "<leader>", "b"] },
    { "before": ["<leader>", ","], "after": ["<leader>", "<leader>", "w"] },
    { "before": ["<leader>", "a"], "commands": ["editor.action.quickFix"] },
    { "before": ["<leader>", "s"], "commands": ["workbench.action.files.save"] },
    { "before": ["<leader>", "c"], "after": [":", "%", "y", "<cr>"] },
    { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
    { "before": ["g", "r"], "commands": ["editor.action.referenceSearch.trigger"] },
    { "before": ["g", "i"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["g", "y"], "commands": ["editor.action.goToTypeDefinition"] },
    { "before": ["g", "p"], "commands": ["editor.action.peekDefinition"] },
    { "before": ["g", "n"], "commands": ["workbench.action.navigateForward"] },
    { "before": ["g", "o"], "commands": ["workbench.action.navigateBack"] },
    { "before": ["J"], "after": ["5", "j"] },
    { "before": ["K"], "after": ["5", "k"] },
    { "before": ["<leader>", "q"], "commands": ["workbench.action.closeAllEditors"] },
    { "before": ["<leader>", "x"], "commands": ["workbench.action.closeEditorsInGroup"] },
    { "before": ["<leader>", "d"], "commands": ["editor.action.insertCursorBelow"] },
    { "before": ["<leader>", "u"], "after": ["<C-u>"] }
  ],

  // ==========================================
  // 7. 界面细节与语法高亮 (UI & Syntax Highlighting)
  // ==========================================
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      { "scope": "punctuation.definition.tag", "settings": { "foreground": "#5C6370" } },
      { "scope": "entity.name.tag", "settings": { "foreground": "#61AFEF" } },
      { "scope": "entity.other.attribute-name", "settings": { "foreground": "#56B6C2" } },
      { "scope": "string.quoted", "settings": { "foreground": "#98C379" } },
      { "scope": "text.xml", "settings": { "foreground": "#ffffff" } },
      { "scope": "comment.block.xml", "settings": { "foreground": "#528BFF" } }
    ]
  },
  "indentRainbow.indicatorStyle": "light",
  "indentRainbow.lightIndicatorStyleLineWidth": 2,
  "indentRainbow.colors": [
    "rgba(255,255,64,0.3)",
    "rgba(127,255,127,0.3)",
    "rgba(255,127,255,0.3)",
    "rgba(79,236,236,0.3)"
  ],
  "workbench.editorAssociations": {
    "{hexdiff}:/**/*.*": "hexEditor.hexedit",
    "*.bin": "hexEditor.hexedit",
    "*.mat": "hexEditor.hexedit",
    "*.so": "hexEditor.hexedit"
  },

  // ==========================================
  // 8. AI 插件与其他扩展配置
  // ==========================================
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "python": true
  },
  "Lingma.cloudModelAutoTriggerGenerateLength": "disable",
  "Lingma.cloudModelEnable": false,
  "Lingma.methodQuickOperation": false,
  "Lingma.aI Chat.commandAllowlistInAgentMode": "npm,python,mvn,java,Select-Object,Get-ChildItem,Where-Object,where,echo,findstr,Get-Content,cd,latexmk,taskkill",
  
  "QoderCN.aI Chat.commandAllowlistInAgentMode": "npm,python,mvn,java,Select-Object,Get-ChildItem,Where-Object,where,echo,findstr,Get-Content,cd,latexmk,taskkill,pip",
  "QoderCN.cloudModelAutoTriggerDisplayRule": false,
  "QoderCN.methodQuickOperation": false,
  "QoderCN.cloudModelAutoTriggerGenerateLength": "disable",
  "QoderCN.cloudModelLanguagesOrFileExtensions": "plaintext,python",

  "trae.enableCodelens": { "enableInlineDocumentation": false, "enableInlineExplain": false },
  "trae.tab.cue": false,
  "trae.tab.enableRename": false,
  "trae.tab.enableAutoImport": false,
  "trae.enableInlineCommand": false,
  "trae.tab.enableTabKeyboardShortcuts": false,
  "trae.enableAddToChatTips": false,

  "codingcopilot.enableCompletionLanguage": { "scminput": false, "python": false },
  "codingcopilot.enableCodelens": false,
  "codingcopilot.enableFloatShortcut": false,
  "codingcopilot.enableAutoCompletions": false,
  "codingcopilot.enableNextEditSuggestions": false,
  "codingcopilot.enableInlineChat": false,
  "codingcopilot.standaloneTerminal": false,
  "codingcopilot.enableInlineChatAutoFormatCode": false,
  "codingcopilot.enableInlineChatShortcutsTip": false,
  "codingcopilot.autoRun": true,
  
  "claudeCode.preferredLocation": "panel",
  "chat.agent.enabled": false,
  "chat.extensionUnification.enabled": false,
  "chatgpt.localeOverride": "zh-CN",
  "powershell.promptToUpdatePowerShell": false,
  
  // 背景图片配置 (已清空敏感路径)
  "backgroundCover.imagePath": "",
  "backgroundCover.opacity": 0.54,
  "backgroundCover.blur": 0,
  "background.fullscreen": {
    "images": [],
    "opacity": 0.1,
    "size": "cover",
    "position": "center",
    "interval": 0,
    "random": false
  },

  // ==========================================
  // 9. 其他个人工具的路径配置 (已清空)
  // ==========================================
  "leetcode.endpoint": "leetcode-cn",
  "leetcode.workspaceFolder": "",
  "remote.SSH.remotePlatform": {},
  "godotTools.editorPath.godot4": "",
  "godotTools.lsp.serverPort": 6005
}
